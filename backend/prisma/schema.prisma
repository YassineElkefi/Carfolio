// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model Vehicle {
  id            String   @id @default(uuid()) @db.Uuid
  make          String
  model         String
  year          Int
  licensePlate  String   @unique
  currentMileage Int     @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  mileageRecords MileageRecord[]
  fuelLogs FuelLog[]
  maintenanceRecords MaintenanceRecord[]
  deadlines VehicleDeadline[]
  vehicleLogs VehicleLog[]
}

model MileageRecord {
  id         String   @id @default(uuid()) @db.Uuid
  vehicleId  String   @db.Uuid
  mileage    Int
  recordedAt DateTime @default(now())
  note       String?

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, recordedAt(sort: Desc)])
}

model FuelLog {
  id                String   @id @default(uuid()) @db.Uuid
  vehicleId         String   @db.Uuid
  date              DateTime @default(now())
  mileage           Int
  liters            Float
  totalCostMillimes Int
  fuelType          String?
  note              String?

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, date(sort: Desc)])
}

model MaintenanceRecord {
  id                String   @id @default(uuid()) @db.Uuid
  vehicleId         String   @db.Uuid

  itemName          String
  category          String?
  purchaseDate      DateTime?
  maintenanceDate   DateTime @default(now())
  mileage           Int

  partCostMillimes  Int      @default(0)
  laborCostMillimes Int      @default(0)

  mechanicName      String?
  notes             String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, maintenanceDate(sort: Desc)])
}

model VehicleDeadline {
  id                String    @id @default(uuid()) @db.Uuid
  vehicleId         String    @db.Uuid
  type              String
  title             String
  dueDate           DateTime?
  dueMileage        Int?
  completedAt       DateTime?
  completedMileage  Int?
  amountMillimes    Int       @default(0)
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, dueDate])
  @@index([vehicleId, type])
}

model VehicleLog {
  id              String   @id @default(uuid()) @db.Uuid
  vehicleId       String   @db.Uuid
  type            String
  date            DateTime
  mileage         Int?
  amountMillimes  Int
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, type, date(sort: Desc)])
}
